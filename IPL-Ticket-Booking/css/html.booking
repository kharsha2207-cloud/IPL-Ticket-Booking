
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IPL Ticket Booking</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            margin: 0;
            padding: 0;
        }

        h1 {
            background-color: #101d45;
            color: white;
            text-align: center;
            padding: 20px;
        }

        form {
            background-color: white;
            width: 400px;
            margin: 30px auto;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
        }

        label {
            font-weight: bold;
        }

        input, select {
            width: 100%;
            padding: 10px;
            margin: 8px 0 15px;
            box-sizing: border-box;
        }

        input[type="checkbox"] {
            width: auto;
        }

        button {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .submit {
            background-color: green;
            color: white;
        }

        .reset {
            background-color: red;
            color: white;
        }
    </style>
</head>

<body>

    <h1>IPL Ticket Booking Form</h1>

    <form action="#" method="get">

        <label for="name">Full Name:</label>
        <input type="text" id="name" name="name"
               placeholder="Enter your name"
               required minlength="3" maxlength="40"
               pattern="[A-Za-z ]{3,40}"
               title="Enter 3 to 40 letters only">

        <label for="email">Email Address:</label>
        <input type="email" id="email" name="email"
               placeholder="Enter your email"
               required maxlength="60">

        <label for="phone">Phone Number:</label>
        <input type="tel" id="phone" name="phone"
               placeholder="Enter 10 digit number"
               required pattern="[0-9]{10}"
               minlength="10" maxlength="10"
               title="Enter exactly 10 digits">

        <label for="match">Select Match:</label>
        <select id="match" name="match" required>
            <option value="">-- Select Match --</option>
            <option>CSK vs MI</option>
            <option>RCB vs KKR</option>
            <option>SRH vs RR</option>
            <option>DC vs PBKS</option>
        </select>

        <label for="stand">Stand Category:</label>
        <select id="stand" name="stand" required>
            <option value="">-- Select Stand --</option>
            <option>General Stand</option>
            <option>Premium Stand</option>
            <option>VIP Stand</option>
            <option>Corporate Box</option>
        </select>

        <label for="tickets">Number of Tickets:</label>
        <input type="number" id="tickets" name="tickets"
               min="1" max="10" value="1" required>

        <label>Additional Preferences:</label><br>

        <input type="checkbox" name="preference"
               value="aisle"> Prefer Aisle Seats<br>

        <input type="checkbox" name="preference"
               value="accessibility"> Accessibility Assistance<br><br>

        <button type="submit" class="submit">
            Submit Booking
        </button>

        <button type="reset" class="reset">
            Reset
        </button>

    </form>

</body>
</html>
